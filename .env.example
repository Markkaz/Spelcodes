# Copy to .env and fill in. .env must never be committed.
#
# Development defaults are baked into compose.yaml, so for local work you only
# need this file if you want to override a port. Production requires every
# value below: compose.prod.yaml uses ${VAR:?required} so it refuses to start
# with anything missing, rather than silently falling back to a default.

# ---- images (production) -------------------------------------------------
# Tag these in CI. Never build on the server.
APP_IMAGE=ghcr.io/markkaz/spelcodes-php:latest
WEB_IMAGE=ghcr.io/markkaz/spelcodes-web:latest

# ---- application ---------------------------------------------------------
APP_URL=https://www.spelcodes.nl

# Bind to loopback and terminate TLS in front of it (Caddy, a load balancer).
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# ---- database ------------------------------------------------------------
# Generate with: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=spelcodes
MYSQL_USER=spelcodes
MYSQL_PASSWORD=
